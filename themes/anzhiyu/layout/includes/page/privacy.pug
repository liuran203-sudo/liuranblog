block content
  #page
    .privacy-page
      .privacy-header
        h1= page.title
        if site.data.privacy.updated
          p.privacy-updated 协议最新更新时间为：#{site.data.privacy.updated}
      #article-container.privacy-content
        if site.data.privacy.sections
          each sec in site.data.privacy.sections
            h2= sec.title
            if sec.content
              != markdown(sec.content)
            if sec.subsections
              each sub in sec.subsections
                h3= sub.title
                if sub.list
                  ul
                    each item in sub.list
                      li!= markdown(item)
            if sec.list && !sec.subsections
              ul
                each item in sec.list
                  li!= markdown(item)

block style
  style.
    .privacy-page {
      max-width: 1300px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }
    .privacy-header {
      margin-bottom: 24px;
    }
    .privacy-header h1 {
      font-size: 2rem;
      font-weight: 700;
      color: var(--anzhiyu-fontcolor);
      margin: 0;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--anzhiyu-card-border);
    }
    .privacy-updated {
      margin: 12px 0 0;
      font-size: 14px;
      color: var(--anzhiyu-secondcolor);
    }
    #aside-content,
    #post-comment,
    .post-comment,
    #card-toc,
    #toc,
    .toc,
    .post-toc,
    .article-toc,
    .toc-container {
      display: none !important;
    }
    .main {
      width: 100% !important;
    }
    @media (max-width: 768px) {
      .privacy-page {
        padding: 24px 16px 60px;
      }
      .privacy-header h1 {
        font-size: 1.5rem;
      }
    }

block script
  script.
    // 隐私政策页面无需额外脚本